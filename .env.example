# ==============================================================================
# Collaborative Real-Time Workspace — Environment Variables Example
# Duplicate this file to .env.local and update with your local values.
# ==============================================================================

# Node Environment ('development' | 'test' | 'production')
NODE_ENV=development

# ------------------------------------------------------------------------------
# Public / Client-accessible Variables (Must be prefixed with NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="NulisBareng"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_ENABLE_REALTIME=false

# ------------------------------------------------------------------------------
# Server-Only Configuration (Never expose to client / browser)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nulis_bareng?schema=public"
AUTH_SECRET="dev-insecure-auth-secret-change-in-production-min-32-chars"
AUTH_URL=http://localhost:3000

# Logging Level ('debug' | 'info' | 'warn' | 'error')
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# Real SMTP Email Delivery Configuration (Mailpit / MailHog / SendGrid / Postmark / Custom SMTP)
# ------------------------------------------------------------------------------
# Sender identity (the application's system email address)
INVITATION_EMAIL_FROM="NulisBareng <notifications@example.com>"

# SMTP Server Host (e.g. smtp.mailgun.org, smtp.sendgrid.net, or localhost for local Mailpit)
SMTP_HOST=localhost

# SMTP Port: 587 (STARTTLS / SMTP_SECURE=false) or 465 (SSL / SMTP_SECURE=true) or 1025 (Mailpit)
SMTP_PORT=1025
SMTP_SECURE=false

# SMTP Authentication credentials (leave blank for local development without auth)
SMTP_USER=
SMTP_PASSWORD=

# Base application URL used in invitation links
APP_URL=http://localhost:3000

